# ClickHouse: логин и пароль можно указать прямо в URL, путь — база данных.
CLICKHOUSE_URL=https://default:password@clickhouse.example.com:8443/stats
# Либо отдельными переменными (имеют приоритет над URL):
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_DATABASE=stats
# CLICKHOUSE_TABLE=rrweb

# Демо в браузере: если задать VITE_CH_URL, демо пойдёт в ClickHouse напрямую (без прокси dev-сервера).
# Логин/пароль при этом попадут в бандл — только для локальной отладки.
# VITE_CH_URL=https://default:password@clickhouse.example.com:8443/stats
